# Resend API key (server only). Create one at https://resend.com/api-keys
RESEND_API_KEY=
# Sender address. onboarding@resend.dev works without a verified domain.
RESEND_FROM_EMAIL=onboarding@resend.dev
# Recipient of contact messages. With onboarding@resend.dev it must be the
# email used to register the Resend account, otherwise Resend rejects it.
CONTACT_TO_EMAIL=
